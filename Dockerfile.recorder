# Debian rather than the bot's alpine base: streamlink pulls in a Python
# toolchain that alpine only builds from source.
FROM oven/bun:debian

WORKDIR /app

# ffmpeg segments the capture, streamlink resolves the stream, rclone uploads.
# yt-dlp is only used by the post-hoc VOD recovery path.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ffmpeg \
        python3 \
        python3-venv \
        ca-certificates \
        curl \
        unzip \
    && python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir streamlink yt-dlp \
    && curl -fsSL https://rclone.org/install.sh | bash \
    && apt-get purge -y unzip \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/opt/venv/bin:${PATH}"

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production

COPY . .

# Bind-mounted in production; created here so a bare `docker run` still works.
RUN mkdir -p db /data/recordings

CMD ["bun", "run", "src/recorder/index.ts"]
